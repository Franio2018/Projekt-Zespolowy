        <mxCell id="yZQ3ExDVNY98BWQhl4SW-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;" value="&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Świadomy wybór: serwer centralny jest monolitem.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;PU komunikują się z nim asynchronicznie (data pump / write-behind),&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 18px; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;więc nie blokuje hot pathu.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Rozbicie tej warstwy na mikroserwisy dodałoby synchronicznych&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 18px; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;wywołań i rozproszonej spójności tam, gdzie potrzebujemy tylko&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 18px; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;jednego spójnego źródła zapisu → to dopiero stworzyłoby bottleneck.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Styl: SBA z monolityczną warstwą trwałości&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;(hybryda SBA + monolit tylko w warstwie system-of-record).&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="440" x="960" y="190" as="geometry" />
        </mxCell>
        <UserObject label="&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Model odtwarzania (dwie warstwy):&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;• Padł węzeł PU → replika partycji / replay z logu brokera = zero utraty (NFR-06)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;• Padł cały region → odtworzenie z Central Server (backup), utrata do ostatniego synca&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;• Padł Central → odbudowa z sumy PU (dane gorące) + backup (historia)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;PU działa autonomicznie, gdy centrala jest niedostępna (sync = best-effort w tle).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Reconciliation po event id + timestamp (idempotencja, jak w NFR-07).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;🔗 Szczegóły: strona „Model awarii i odtwarzania” (kliknij)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" link="data:page/id,RecoveryModelPage" id="yZQ3ExDVNY98BWQhl4SW-2">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;" vertex="1">
            <mxGeometry height="260" width="440" x="960" y="600" as="geometry" />
          </mxCell>
        </UserObject>
