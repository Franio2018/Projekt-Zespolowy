        <mxCell id="PxiFsgjMPb7hJRQIP81X-9" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;perimeter=cloudPerimeter;" value="Outside&lt;div&gt;Services&lt;/div&gt;" vertex="1">
